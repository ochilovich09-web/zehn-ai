# ─── Server ──────────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# ─── Security ────────────────────────────────────────────────────────────
# Production'da albatta o'zgartiring (kamida 32 belgi)
JWT_SECRET=change-me-to-a-long-random-secret-string-please
ACCESS_TOKEN_TTL=900          # 15 daqiqa (sekundlarda)
REFRESH_TOKEN_TTL=2592000     # 30 kun (sekundlarda)

# ─── Fayl yuklash ────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760        # 10 MB
MAX_FILES_PER_MESSAGE=5

# ─── Email (verification) ────────────────────────────────────────────────
# dev rejimda xat konsolga chiqariladi
MAIL_TRANSPORT=console

# ─── AI provider ─────────────────────────────────────────────────────────
# Kalitsiz platforma "Local Reasoning Engine" (offline demo) rejimida ishlaydi.
# Provayder kalit ko'rinishidan avtomatik aniqlanadi:
#   AQ.… yoki AIza…  -> gemini
#   sk-ant-…         -> anthropic
# Majburlash uchun: AI_PROVIDER=gemini | anthropic
AI_PROVIDER=

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Console: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Gemini:    gemini-3.5-flash | gemini-3.8-flash | gemini-2.5-pro
# Anthropic: claude-sonnet-5 | claude-opus-5
AI_MODEL=gemini-3.5-flash
AI_MAX_TOKENS=2048

# ─── Ma'lumotlar bazasi ──────────────────────────────────────────────────
# Bo'sh qoldirilsa — lokal SQLite fayli (DATA_DIR/app.db).
# Turso: panel → Database → Generate Token  (yoki: turso db tokens create <baza>)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# SQLite fayli va yuklangan fayllar papkasi (hostingda volume'ga yo'naltiring)
DATA_DIR=
